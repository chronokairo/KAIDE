{
  "name": "chronokairo-desktop",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "web-ai"
  ],
  "scripts": {
    "dev": "next dev --webpack -p 3010",
    "build": "cross-env TAURI_BUILD=true next build --webpack",
    "start": "next start -p 3010",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "web-ai:dev": "npm --workspace @chronokairo/ai run dev",
    "web-ai:build": "npm --workspace @chronokairo/ai run build"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.93",
    "@assistant-ui/react": "^0.15.15",
    "@tauri-apps/api": "^2.0.0",
    "ai": "^7.0.90",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2"
  }
}
