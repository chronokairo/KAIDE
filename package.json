{
  "name": "@chronokairo/ai",
  "version": "1.0.0",
  "description": "Sistema RAG com APIs TOTVS e interface MCP para consultas inteligentes",
  "main": "src/api/main.ts",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"deno task dev:server\" \"deno task dev:client\"",
    "dev:server": "tsx watch src/api/main.ts",
    "dev:client": "vite",
    "build": "vite build && tsc --noEmit",
    "start": "tsx src/api/main.ts",
    "mcp": "tsx src/api/mcp-server.ts",
    "check:ollama-models": "tsx src/api/features/rag/check-install-ollama-models.ts",
    "install:all": "npm install",
    "clean": "deno eval \"Deno.removeSync('dist',{recursive:true})\"",
    "test": "echo \"No tests specified\" && exit 0",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write src"
  },
  "keywords": [
    "rag",
    "ai",
    "totvs",
    "mcp",
    "vector-search",
    "ollama",
    "react",
    "express"
  ],
  "author": "Luann",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.4.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "chart.js": "^4.4.0",
    "chartjs-node-canvas": "^4.1.6",
    "compression": "^1.7.4",
    "concurrently": "^8.2.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "html2canvas": "^1.4.1",
    "http": "^0.0.1-security",
    "http-proxy-middleware": "^3.0.5",
    "jspdf": "^2.5.1",
    "lowdb": "^7.0.1",
    "lucide-react": "^0.294.0",
    "node-cache": "^5.1.2",
    "nodemon": "^3.0.2",
    "ollama": "^0.6.3",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "systeminformation": "^5.27.13",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^8.2.3",
    "@types/html2canvas": "^1.0.0",
    "@types/http-proxy-middleware": "^1.0.0",
    "@types/jspdf": "^1.3.3",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/systeminformation": "^3.54.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-order": "^7.0.1",
    "tailwindcss": "^3.3.6",
    "ts-node": "^10.9.2",
    "vite": "^5.0.8"
  },
  "engines": {
    "deno": ">=2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chronokairo/ai.git"
  },
  "bugs": {
    "url": "https://github.com/chronokairo/ai/issues"
  },
  "homepage": "https://github.com/chronokairo/ai#readme"
}
