{
  "name": "kaide",
  "private": true,
  "version": "1.0.0",
  "description": "Kaide (Kairos Code + AI + IDE) — monorepo: apps/web (Next), apps/desktop (Tauri), kaide-rs/ (Rust), sdk/, tools/. Espelho do layout de openai/codex, via npm (ver ADR-0042).",
  "workspaces": [
    "apps/web",
    "sdk/typescript"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @chronokairo/kaide",
    "build": "npm run build --workspace @chronokairo/kaide",
    "build:web": "npm run build:web --workspace @chronokairo/kaide",
    "start": "npm run start --workspace @chronokairo/kaide",
    "typecheck": "npm run typecheck --workspace @chronokairo/kaide",
    "test": "npm run test --workspace @chronokairo/kaide",
    "job:commercial:followup": "npm run job:commercial:followup --workspace @chronokairo/kaide",
    "job:commercial:daily": "npm run job:commercial:daily --workspace @chronokairo/kaide",
    "job:qa:review_pr": "npm run job:qa:review_pr --workspace @chronokairo/kaide",
    "rust:check": "cargo check --manifest-path kaide-rs/Cargo.toml",
    "rust:test": "cargo test --manifest-path kaide-rs/Cargo.toml -p kaide",
    "desktop:dev": "npm run desktop:dev --workspace @chronokairo/kaide-sdk",
    "desktop:build": "npm run desktop:build --workspace @chronokairo/kaide-sdk"
  }
}
