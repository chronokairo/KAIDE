# Supabase Self-Hosted - Variáveis de Ambiente
# Copie para .env antes de executar: cp .env.example .env

POSTGRES_PASSWORD=your-super-secret-postgres-password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
STUDIO_PORT=3001

API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:3010
ADDITIONAL_REDIRECT_URLS=http://localhost:3010,http://127.0.0.1:3010

# Gere um JWT_SECRET com no mínimo 32 caracteres
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

# Chaves de API para PostgREST e Kong Gateway
# Em produção, assine tokens JWT com o mesmo JWT_SECRET usando a role 'anon' e 'service_role'
ANON_KEY=REMOVED_EXPOSED_CREDENTIAL
SERVICE_ROLE_KEY=REMOVED_EXPOSED_CREDENTIAL
