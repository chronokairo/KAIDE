# Example environment configuration
# Copy this file to .env and fill in your values

# Required: Your NVIDIA API key from https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Customize NVIDIA API base URL
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: Benchmark parameters
# Number of latency test rounds per model (default: 3)
# RANK_PROBE_ROUNDS=3

# Request timeout in milliseconds (default: 12000)
# RANK_PROBE_TIMEOUT_MS=12000

# Max tokens for latency probes (default: 24)
# RANK_PROBE_MAX_TOKENS=24
