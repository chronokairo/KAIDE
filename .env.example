# Kaide - Variáveis de Ambiente & Integrações

# --- Supabase (PostgreSQL, Auth, pgvector, Storage) ---
# Projeto Dev: your-dev-project-ref (chronokairo-dev)
# Projeto Prod: your-project-ref (chronokairo-prod)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID_DEV=your-dev-project-ref
SUPABASE_PROJECT_ID_PROD=your-project-ref

# --- GitHub (Organização ChronoKairo) ---
GITHUB_ORG=chronokairo
GITHUB_AI_REPO=https://github.com/chronokairo/kaide.git
GITHUB_TOKEN=

# --- GitLab (Grupo ChronoKairo) ---
GITLAB_GROUP=chronokairo
GITLAB_AI_REPO=https://gitlab.com/chronokairo/kaide.git
GITLAB_CLI_REPO=https://gitlab.com/chronokairo/cli.git
GITLAB_TOKEN=

# --- LLM Providers & Observabilidade ---
OLLAMA_BASE_URL=http://localhost:11434
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Resend (Envio de E-mail Transacional) ---
# Dashboard: https://resend.com/domains
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Control Plane (Identidade de Execução dos Jobs) ---
# organizationId e userId validados no servidor em toda ferramenta de escrita
CONTROL_PLANE_ORGANIZATION_ID=
CONTROL_PLANE_ACTOR_USER_ID=


# Expostos ao browser (mesmos valores de CONTROL_PLANE_*)
NEXT_PUBLIC_CONTROL_PLANE_ORGANIZATION_ID=
NEXT_PUBLIC_CONTROL_PLANE_ACTOR_USER_ID=
